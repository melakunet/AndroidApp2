<?xml version="1.0" encoding="utf-8"?>
<!-- A single puff of steam. The radial gradient fades from faint white in the
     centre to fully transparent at the edge, which gives a soft blurred look
     without needing a real blur effect (RenderEffect requires API 31+). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#B3FFFFFF"
        android:centerColor="#66FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>