<?xml version="1.0" encoding="utf-8"?>
<!-- Root layout. The animated background is the first child so it sits behind
     all screen content that gets added on top of it in later steps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.melakunet.androidapp2.views.CoffeeSmokeBackground
        android:id="@+id/coffeeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>